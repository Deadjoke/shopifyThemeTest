<div class="cart-page">

  <div class="cart-container">

    <h1 class="cart-title">Your Cart</h1>


    {% if cart.item_count > 0 %}

      <form action="{{ routes.cart_url }}" method="post">

        <div class="cart-content">


          <!-- =========================
               Cart Items
          ========================== -->

          <div class="cart-items">

            {% for item in cart.items %}

              <div class="cart-item">


                <!-- Product Image -->

                <div class="cart-item-image">

                  {% if item.image %}

                    <img
                      src="{{ item.image | image_url: width: 300 }}"
                      alt="{{ item.image.alt | escape }}"
                      width="150"
                      height="150"
                    >

                  {% endif %}

                </div>


                <!-- Product Information -->

                <div class="cart-item-info">


                  <div class="cart-item-header">

                    <h2>
                      {{ item.product.title }}
                    </h2>


                    {% if item.variant.title != 'Default Title' %}

                      <p class="cart-item-variant">
                        {{ item.variant.title }}
                      </p>

                    {% endif %}

                  </div>


                  <!-- Unit Price -->

                  <p class="cart-item-price">
                    {{ item.final_price | money }}
                  </p>


                  <!-- Quantity + Total -->

                  <div class="cart-item-bottom">


                    <div class="quantity-control">

                      <label for="quantity-{{ item.key }}">
                        Quantity
                      </label>

                      <input
                        id="quantity-{{ item.key }}"
                        type="number"
                        name="updates[]"
                        value="{{ item.quantity }}"
                        min="0"
                      >

                    </div>


                    <p class="cart-item-total">
                      {{ item.final_line_price | money }}
                    </p>


                  </div>


                  <!-- Remove -->

                  <a
                    href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0"
                    class="remove-button"
                  >
                    Remove
                  </a>


                </div>

              </div>

            {% endfor %}

          </div>


          <!-- =========================
               Cart Summary
          ========================== -->

          <div class="cart-summary">

            <h2>
              Order Summary
            </h2>


            <div class="summary-row">

              <span>
                Subtotal
              </span>

              <span>
                {{ cart.total_price | money }}
              </span>

            </div>


            <p class="summary-note">
              Taxes and shipping calculated at checkout.
            </p>


            <!-- Checkout -->

            <button
              type="submit"
              name="checkout"
              class="checkout-button"
            >
              Checkout
            </button>


            <!-- Update Cart -->

            <button
              type="submit"
              class="update-button"
            >
              Update Cart
            </button>


          </div>

        </div>

      </form>


    {% else %}


      <!-- =========================
           Empty Cart
      ========================== -->

      <div class="empty-cart">


        <div class="empty-cart-icon">
          🛒
        </div>


        <h2>
          Your cart is empty
        </h2>


        <p>
          Looks like you haven't added anything to your cart yet.
        </p>


        <a
          href="{{ routes.all_products_collection_url }}"
          class="continue-shopping"
        >
          Continue Shopping
        </a>


      </div>


    {% endif %}

  </div>

</div>
{% stylesheet %}

.cart-page {
  background: #f7f7f7;
  min-height: 70vh;
  padding: 60px 20px;
}


.cart-container {
  max-width: 1200px;
  margin: 0 auto;
}


.cart-title {
  font-size: 42px;
  font-weight: 700;

  margin: 0 0 40px;
}


/* =========================
   Cart Layout
========================= */

.cart-content {
  display: grid;

  grid-template-columns: 1fr 350px;

  gap: 40px;

  align-items: start;
}


/* =========================
   Cart Items
========================= */

.cart-items {
  display: flex;

  flex-direction: column;

  gap: 20px;
}


.cart-item {
  background: white;

  border: 1px solid #e5e5e5;

  border-radius: 12px;

  padding: 20px;

  display: flex;

  gap: 25px;
}


/* =========================
   Product Image
========================= */

.cart-item-image {
  width: 150px;
  height: 150px;

  flex-shrink: 0;

  background: #f5f5f5;

  border-radius: 8px;

  overflow: hidden;
}


.cart-item-image img {
  width: 100%;
  height: 100%;

  object-fit: cover;

  display: block;
}


/* =========================
   Product Information
========================= */

.cart-item-info {
  flex: 1;

  display: flex;

  flex-direction: column;

  justify-content: space-between;
}


.cart-item-header h2 {
  font-size: 20px;

  margin: 0 0 8px;
}


.cart-item-variant {
  color: #777;

  font-size: 14px;

  margin: 0;
}


.cart-item-price {
  font-size: 18px;

  font-weight: 600;

  margin: 15px 0;
}


/* =========================
   Quantity + Line Total
========================= */

.cart-item-bottom {
  display: flex;

  align-items: end;

  justify-content: space-between;
}


.quantity-control label {
  display: block;

  font-size: 13px;

  color: #666;

  margin-bottom: 6px;
}


.quantity-control input {
  width: 75px;

  padding: 10px;

  border: 1px solid #ccc;

  border-radius: 6px;

  font-size: 15px;
}


.cart-item-total {
  font-size: 18px;

  font-weight: 700;

  margin: 0;
}


/* =========================
   Remove Button
========================= */

.remove-button {
  align-self: flex-start;

  margin-top: 15px;

  padding: 8px 14px;

  background: transparent;

  border: 1px solid #ddd;

  border-radius: 6px;

  color: #777;

  font-size: 14px;

  text-decoration: none;

  cursor: pointer;

  transition: 0.2s ease;
}


.remove-button:hover {
  color: #d32f2f;

  border-color: #d32f2f;

  background: #fff5f5;
}


/* =========================
   Cart Summary
========================= */

.cart-summary {
  background: white;

  padding: 30px;

  border-radius: 12px;

  border: 1px solid #e5e5e5;

  position: sticky;

  top: 20px;
}


.cart-summary h2 {
  font-size: 24px;

  margin: 0 0 25px;
}


.summary-row {
  display: flex;

  justify-content: space-between;

  padding-bottom: 20px;

  border-bottom: 1px solid #eee;

  font-size: 18px;
}


.summary-row span:last-child {
  font-weight: 700;
}


.summary-note {
  color: #777;

  font-size: 14px;

  line-height: 1.5;

  margin: 20px 0 25px;
}


/* =========================
   Buttons
========================= */

.checkout-button,
.update-button {
  width: 100%;

  padding: 15px;

  border-radius: 7px;

  font-size: 16px;

  font-weight: 600;

  cursor: pointer;
}


.checkout-button {
  border: none;

  background: #111;

  color: white;

  margin-bottom: 12px;
}


.checkout-button:hover {
  opacity: 0.85;
}


.update-button {
  background: white;

  color: #111;

  border: 1px solid #ccc;
}


.update-button:hover {
  background: #f5f5f5;
}


/* =========================
   Empty Cart
========================= */

.empty-cart {
  background: white;

  border: 1px solid #e5e5e5;

  border-radius: 12px;

  padding: 80px 20px;

  text-align: center;
}


.empty-cart-icon {
  font-size: 50px;

  margin-bottom: 20px;
}


.empty-cart h2 {
  font-size: 28px;

  margin: 0 0 10px;
}


.empty-cart p {
  color: #666;

  margin-bottom: 30px;
}


.continue-shopping {
  display: inline-block;

  padding: 14px 25px;

  background: #111;

  color: white;

  text-decoration: none;

  border-radius: 7px;

  font-weight: 600;
}


.continue-shopping:hover {
  opacity: 0.85;
}


/* =========================
   Tablet
========================= */

@media (max-width: 800px) {

  .cart-page {
    padding: 40px 15px;
  }


  .cart-title {
    font-size: 32px;

    margin-bottom: 25px;
  }


  .cart-content {
    grid-template-columns: 1fr;
  }


  .cart-summary {
    position: static;
  }

}


/* =========================
   Mobile
========================= */

@media (max-width: 550px) {

  .cart-item {
    padding: 15px;

    gap: 15px;
  }


  .cart-item-image {
    width: 100px;

    height: 100px;
  }


  .cart-item-header h2 {
    font-size: 16px;
  }


  .cart-item-price {
    font-size: 15px;
  }


  .cart-item-bottom {
    align-items: start;

    flex-direction: column;

    gap: 15px;
  }


  .cart-item-total {
    font-size: 16px;
  }


  .remove-button {
    margin-top: 12px;
  }

}

{% endstylesheet %}